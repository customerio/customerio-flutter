source "https://rubygems.org"

git_source(:github) { |repo_name| "https://github.com/#{repo_name}" }

# Security pins for transitive deps (MBL-1691)
# activesupport 8.x bump (MBL-1682) still deferred. The Ruby floor is no longer the blocker
# (CI moved to 3.4 in MBL-2245), but cocoapods-core still declares activesupport (>= 5.0, < 8)
# -- checked against 1.17.0, so the cap is not just a stale-version problem. Landing MBL-1682
# waits on cocoapods itself lifting that constraint.
gem 'json', '2.10.2'
gem 'addressable', '2.9.0'
gem 'faraday', '1.10.5'
gem 'aws-sdk-s3', '1.208.0'
gem 'rexml', '3.4.2'

gem 'fastlane'
gem 'cocoapods'
gem 'minitest', '~> 5.25'

plugins_path = File.join(File.dirname(__FILE__), 'fastlane', 'Pluginfile')
eval_gemfile(plugins_path) if File.exist?(plugins_path)
